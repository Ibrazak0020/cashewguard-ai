  "stepByStepGuide": "Nduzi Nzọụkwụ-n'-Nzọụkwụ",
  "step1Title": "Nyochaa Osisi Ọ Bụla",
  "step1Desc": "Gaa n'ubi gị wee lelee osisi ọ bụla maka ọnya ochie, ntụpọ gum, osisi nwụrụ anwụ, na mmebi ụmụ ahụhụ fọdụrụ site n'oge gara aga. Dekọọ osisi ndị ga-achọ nlebara anya karịsịa mgbe udu mmiri malitere.",
  "step1Duration": "nkeji 15/osisi",
  "step2Title": "Kpụ Ma Dị Ọcha",
  "step2Desc": "Wepụ wee gbaa ọkụ ma ọ bụ likpuo alaka nwụrụ anwụ, mkpụrụ osisi kpọrọ nkụ, na akwụkwọ nwere ọrịa nke ukwuu. Meghee elu osisi ka ikuku baa nke ọma — elu osisi jupụtara ma nwee ndo na-akwado Red Rust na mgbasa fungal.",
  "step2Duration": "nkeji 20-30/osisi",
  "step3Title": "Tinye Ọgwụ Kọpa Nchebe",
  "step3Desc": "Fesa ọgwụ fungicide nke ọla kọpa n'elu osisi niile yana kpọmkwem n'ebe ọ bụla e kpụrụ osisi tupu mmiri ozuzo siri ike izo. Otu nzọụkwụ a bụ ihe nchebe kachasị dị irè megide Anthracnose na Red Rust.",
  "step3Duration": "ụbọchị 1 (ubi niile)",
  "step4Title": "Melite Ntapu Mmiri",
  "step4Desc": "Kpochapụ ọwa mmiri gburugburu ala osisi ọ bụla ka mmiri ghara ịkwụsị n'osisi. Ala mmiri jupụtara bụ isi ihe kpatara mbugharị Gumosis.",
  "step4Duration": "Ọkara ụbọchị",
  "step5Title": "Hazie Usoro Nleba Anya Kwa Izu",
  "step5Desc": "Ozugbo udu mmiri malitere, jiri CashewGuard AI nyochaa osisi gị kwa izu. Mee ruo Ọktoba bụ oge ihe egwu kachasị elu maka Anthracnose, Gumosis, na Red Rust — ịchọpụta mgbaàmà n'oge ọ bụ na-emeso ọrịa tupu nnukwu mmebi eruo.",
  "step5Duration": "Na-aga n'ihu, kwa izu",
