  "stepByStepGuide": "Step-by-Step Guide",
  "@stepByStepGuide": {},
  "step1Title": "Inspect Every Tree",
  "@step1Title": {},
  "step1Desc": "Walk your farm and check each tree for old lesions, gum spots, dead wood, and leftover pest damage from last season. Note which trees will need extra attention once the rains start.",
  "@step1Desc": {},
  "step1Duration": "15 min/tree",
  "@step1Duration": {},
  "step2Title": "Prune and Sanitize",
  "@step2Title": {},
  "step2Desc": "Remove and burn or bury dead branches, mummified fruits, and heavily infected leaves. Open up the canopy for better airflow — dense, shaded canopies favor Red Rust and fungal spread.",
  "@step2Desc": {},
  "step2Duration": "20-30 min/tree",
  "@step2Duration": {},
  "step3Title": "Apply Preventive Copper Spray",
  "@step3Title": {},
  "step3Desc": "Spray a copper-based fungicide across the canopy and directly on any pruning wounds before the first heavy rains fall. This single step is the most effective defense against Anthracnose and Red Rust.",
  "@step3Desc": {},
  "step3Duration": "1 day (whole farm)",
  "@step3Duration": {},
  "step4Title": "Improve Drainage",
  "@step4Title": {},
  "step4Desc": "Clear drainage channels around the base of each tree so water cannot pool at the trunk. Waterlogged soil is the leading cause of Gumosis outbreaks.",
  "@step4Desc": {},
  "step4Duration": "Half day",
  "@step4Duration": {},
  "step5Title": "Set a Weekly Monitoring Routine",
  "@step5Title": {},
  "step5Desc": "Once the rains begin, scan your trees weekly with CashewGuard AI. May through October is peak risk season for Anthracnose, Gumosis, and Red Rust — catching symptoms early means treating before major damage is done.",
  "@step5Desc": {},
  "step5Duration": "Ongoing, weekly",
  "@step5Duration": {},
  "importantSafetyNote": "Important Safety Note",
  "@importantSafetyNote": {},
  "safetyNoteText": "Always wear gloves and a mask when handling fungicides. Avoid spraying on windy days or right before rain, and keep children and livestock away from treated trees until the spray has fully dried.",
  "@safetyNoteText": {},
